<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
            <Table id="idTableSCart" inset="false">
                <headerToolbar>
                    <OverflowToolbar id="idOFT">
                        <content>
                            <Title id="idTableTitleSCart" text="{i18n>sCartLbl}"/>
                            <ToolbarSpacer id="idTSpacer"/>
                            <Button id="idBtnAddItems" icon="sap-icon://cart-4" tooltip="{i18n>addToCartTip}" press="onAddItem"/>
                        </content>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column id="idCol1">
                        <Text id="idColText1" text="{i18n>itemColTxt}" />
                    </Column>
                    <Column id="idCol2">
                        <Text id="idColText2" text="{i18n>qtyColTxt}" />
                    </Column>
                    <Column id="idCol3">
                        <Text id="idColText3" text="{i18n>priceColTxt}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem id="idColListItem1" vAlign="Middle">
                        <cells>
                            <Text id="idText1" text="{i18n>iphoneProMaxTxt}" />
                            <Text id="idText2" text="{i18n>iphoneProMaxQtyTxt}" />
                            <Text id="idText3" text="{i18n>iphoneProMaxPriceTxt}" />
                        </cells>
                    </ColumnListItem>
                    <ColumnListItem id="idColListItem2" vAlign="Middle">
                        <cells>
                            <Text id="idText4" text="{i18n>louisVTxt}" />
                            <Text id="idText5" text="{i18n>louisVQtyTxt}" />
                            <Text id="idText6" text="{i18n>louisVPriceTxt}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
</core:FragmentDefinition>
